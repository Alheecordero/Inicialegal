# Copiar a .env y ajustar
DEBUG=True
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1,inicialegal.cl,www.inicialegal.cl
CSRF_TRUSTED_ORIGINS=https://inicialegal.cl,https://www.inicialegal.cl
SITE_URL=https://inicialegal.cl
# False mientras el sitio esté en desarrollo (robots.txt Disallow + X-Robots-Tag noindex)
SITE_INDEXING=False

# Base de datos (SQLite por defecto). Ejemplo PostgreSQL:
# DATABASE_URL=postgres://usuario:clave@localhost:5432/inicialegal
# DATABASE_URL=sqlite:///db.sqlite3

# Email. En desarrollo imprime en consola. Ejemplo SMTP:
# Clave de aplicación de formularios@inicialegal.cl. No pegarla en el chat.
# EMAIL_URL=smtp+tls://formularios@inicialegal.cl:CLAVE_DE_APLICACION@smtp.gmail.com:587
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=Inicia Legal <formularios@inicialegal.cl>
CONTACT_NOTIFY_EMAIL=contacto@inicialegal.cl
# Confirmación al cliente (por defecto usa contacto@). Aviso interno sigue desde formularios@.
# CONTACT_CLIENT_FROM_EMAIL=Inicia Legal <contacto@inicialegal.cl>

# Asistente conversacional. En desarrollo funciona con respuesta local si no hay API configurada.
ASSISTANT_ENABLED=True
# Endpoint compatible con OpenAI Chat Completions, ej: https://api.openai.com/v1/chat/completions
ASSISTANT_API_URL=
ASSISTANT_API_KEY=
ASSISTANT_MODEL=gpt-4o-mini
ASSISTANT_TIMEOUT=20
ASSISTANT_MAX_INPUT_CHARS=900
ASSISTANT_MAX_CONTEXT_ITEMS=5
ASSISTANT_RATE_LIMIT=12
# False evita guardar conversaciones con posibles datos personales.
ASSISTANT_LOG_CONVERSATIONS=False
