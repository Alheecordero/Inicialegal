[Unit]
Description=gunicorn daemon for Inicia Legal
Requires=gunicorn-inicialegal.socket
After=network.target postgresql.service

[Service]
Type=notify
User=www-data
Group=www-data
UMask=0027
WorkingDirectory=/var/www/inicialegal
EnvironmentFile=/var/www/inicialegal/.env
Environment=DJANGO_SETTINGS_MODULE=config.settings
ExecStart=/var/www/inicialegal/venv/bin/gunicorn \
    --access-logfile - \
    --workers 3 \
    --timeout 120 \
    --bind unix:/run/gunicorn-inicialegal.sock \
    config.wsgi:application
Restart=on-failure
RestartSec=5
# Sin root: si algo en Django o sus dependencias se rompe, el daño queda dentro de www-data.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
